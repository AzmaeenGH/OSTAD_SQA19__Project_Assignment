          "script": {
            "exec": [
              "// testing",
              "",
              "pm.test(\"1.1 Status code is 200\", function (){ pm.response.to.have.status(200);",
              "});",
              "",
              "const users = pm.response.json();",
              "",
              "",
              "pm.test(\"1.2 Response body is an array and it is non-empty\", function () { pm.expect(users).to.be.an('array').that.is.not.empty;  ",
              "});",
              "",
              "",
              "",
              "",
              "pm.test(\"1.3 Response contains user information.\", function(){",
              "    users.forEach(user=>{",
              "        pm.expect(user).to.include.keys(\"id\", \"name\", \"username\", \"email\", \"address\", \"phone\", \"website\", \"company\");",
              "        pm.expect(user.address).to.include.keys(\"street\", \"suite\", \"city\", \"zipcode\", \"geo\");",
              "        pm.expect(user.address.geo).to.include.keys(\"lat\", \"lng\");",
              "        pm.expect(user.company).to.include.keys(\"name\", \"catchPhrase\", \"bs\"); ",
              "        })",
              "});",
              "",
              "",
              "",
              "",
              "pm.test(\"1.4 Each post has required fields (id, name and email)\", function () {",
              "    // const users = pm.response.json();",
              "    users.forEach(user => {",
              "        pm.expect(user).to.have.property(\"id\");",
              "        pm.expect(user).to.have.property(\"name\");",
              "        pm.expect(user).to.have.property(\"email\");",
              "    });",
              "});",
              "",
              "",
              "",
              "",
              ""
